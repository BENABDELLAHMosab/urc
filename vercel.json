{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/rooms.js": {
      "includeFiles": "node_modules/@vercel/postgres/dist/**"
    },
    "api/room-messages.js": {
      "includeFiles": "node_modules/@vercel/postgres/dist/**"
    },
    "api/message.js": {
      "includeFiles": "node_modules/@vercel/postgres/dist/**"
    },
    "api/login.js": {
      "includeFiles": "node_modules/@vercel/postgres/dist/**"
    },
    "api/register.js": {
      "includeFiles": "node_modules/@vercel/postgres/dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)|src(?:/|$)|assets(?:/|$)|node_modules(?:/|$)|@|.*\\.[^/]+$).*)",
      "destination": "/index.html"
    }
  ]
}
